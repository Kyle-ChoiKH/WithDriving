<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the night backdrop and the app icon, so the first frame of the app (which fades
         from the same night colour to the last theme's backdrop) follows without a flash. -->
    <style name="Theme.Vroomi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vroomi_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/vroomi_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
